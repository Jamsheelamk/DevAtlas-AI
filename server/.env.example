# DevAtlas AI Environment Variables
PORT=5001

# Groq API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=

# Default Groq Models
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Qdrant Vector DB (Optional - defaults to high-performance local vector store if empty)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=devatlas_knowledge

# Upstash Redis (Optional - defaults to high-speed in-memory LRU cache if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
